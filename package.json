		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^22.19.11",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"cf": "1.0.0-beta.12",
		"daisyui": "^5.5.23",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"vite": "7.3.6",
		"vite-tsconfig-paths": "^6.1.1",
		"wrangler": "^4.130.0"
