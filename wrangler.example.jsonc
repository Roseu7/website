// Review example only. Configure your own hosts, bindings and Access protection.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-review",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "WORDLE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "YOUR_DATABASE_NAME",
      "database_id": "YOUR_DATABASE_ID",
      "migrations_dir": "db/migrations"
    }
  ]
}
